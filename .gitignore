/agent/agents/
/agent/.sync/
/agent/.snapshots/

# Codex login tokens (CODEX_HOME for the orchestrator container) — NEVER commit
/agent/.codex-home/

# Runtime journal of the admin agent — local data, never shipped
/agent/admin-audit.jsonl

# Project resource library (user content) — never shipped
/agent/resources/
