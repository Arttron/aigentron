# ======================================================================
# Local Dev Server — environment template. Copy to `.env` and fill in.
# NEVER commit a real .env. All secrets are injected via env only.
# ======================================================================

# ---- Core infra (docker-compose service hostnames) -------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/orchestrator?schema=public
REDIS_URL=redis://redis:6379

# Ports exposed on the host
ORCHESTRATOR_PORT=3001
DASHBOARD_PORT=3000

# ---- Dashboard -> Orchestrator wiring --------------------------------
# Only used by the dashboard's OWN hot-reload dev server (this `full` profile).
# Public URLs the browser uses to reach the orchestrator (REST + WebSocket).
# The orchestrator also serves the dashboard itself, same-origin, off its own
# port — these vars only matter for the separate dev server's cross-origin case.
VITE_ORCHESTRATOR_URL=http://localhost:3001
VITE_ORCHESTRATOR_WS_URL=ws://localhost:3001

# ======================================================================
# MODEL ROUTING — single source of truth lives in packages/shared.
# The orchestrator injects the right vars into each agent at spawn time
# based on the task tier (routine | complex).
# ======================================================================

# ---- routine tier  ->  local Ollama (Anthropic-compatible endpoint) --
# Ollama runs on the HOST machine. The container reaches it via the docker
# host gateway; on the host directly it's http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Token value is arbitrary for Ollama but must be present.
OLLAMA_AUTH_TOKEN=ollama
# A coding model with tool-use support. Must be pulled into Ollama first.
ROUTINE_MODEL=qwen3-coder:30b

# ---- complex tier  ->  cloud Anthropic API ---------------------------
# Seeds the `claude-cloud` provider with authMode=api-key (pay-per-token).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COMPLEX_MODEL=claude-sonnet-4-6

# Alternative to the above: authMode=oauth-token uses a CLI-minted Claude
# subscription token instead of a pay-per-token API key (run
# `claude setup-token`, or `scripts/cli-auth.sh <provider-name>` to mint +
# register it in one step). Not seeded from env — add/switch a provider to
# it from the dashboard, or via scripts/cli-auth.sh, after first boot; a
# provider on api-key and one on oauth-token can coexist side by side. See
# packages/shared/src/routing.ts resolveProvider() for what this changes
# (bypasses LiteLLM; no subagent delegation from that provider). Using your
# personal subscription this way is your own call against Anthropic's usage
# policies, not something this repo decides for you.
#
# Expires after 1 year (a static token, no auto-refresh) — rotate it by
# re-running `claude setup-token` (or `scripts/cli-auth.sh <name>` /
# infra/setup-wizard.mjs's "rotate an existing provider's secret" step) with
# the same provider name; it updates the existing provider, not a duplicate.

# NOTE: the vars above only SEED two default providers on first boot —
# `ollama-local` (OLLAMA_BASE_URL + ROUTINE_MODEL + OLLAMA_AUTH_TOKEN) and
# `claude-cloud` (ANTHROPIC_API_KEY + COMPLEX_MODEL). After that, manage
# providers (endpoints + models + keys/tokens) in the dashboard → Settings →
# Providers. Agents (./agent/agents/*.md) pick a provider by name.
#
# For a tool-capable local model, pick one that emits structured tool_calls
# (qwen2.5-coder:32b does NOT — it returns tool calls as plain text and breaks
# the agent SDK; qwen3-coder and the Qwopus coder GGUF do). Ollama's native
# /v1/messages works directly, or front it with the compose `litellm` service.

# ---- LiteLLM admin key -----------------------------------------------
# Shared secret between the orchestrator and the litellm proxy, used to manage
# cloud-proxy model routes from the dashboard (LiteLLM admin API). The
# orchestrator is the only caller. Upstream provider keys are NOT set here —
# they live in each provider (DB) and are pushed to litellm per route.
LITELLM_MASTER_KEY=sk-lds-master-dev

# ======================================================================
# AGENT RUNTIME
# ======================================================================
# Path INSIDE the orchestrator container to the git repo agents develop in.
# A per-task worktree + branch is created under here. Leave as-is for docker.
WORKSPACE_REPO_PATH=/workspace/repo

# The workspace is provisioned by the orchestrator into a docker volume by
# default (no host bind needed). Set these to seed it from a git repository;
# leave empty to have agents work in a local git-init'd workspace.
#   REPO_URL=https://github.com/org/project.git
#   REPO_BRANCH=main
#   GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# These seed the DB-backed settings on first boot; thereafter edit them in the
# dashboard Settings page.

# HOST directory the agents work in, bind-mounted to WORKSPACE_REPO_PATH above.
# Visible/seedable on the host; the orchestrator clones repoUrl into it or
# git-inits it. Defaults to ./project.
PROJECT_HOST_PATH=./project

# Root under which per-task git worktrees are created.
WORKTREES_ROOT=/workspace/.worktrees

# Agent operational files (skills + generated per-run settings), kept OUT of the
# project. Container path; host dir is bind-mounted via AGENT_HOST_PATH.
AGENT_DIR=/workspace/agent
AGENT_HOST_PATH=./agent

# The shared workspace: memory / work / deliverables for the agents' non-code results (created automatically).
# Default: next to the agent dir (/workspace/workspace in the dev stack, <data>/workspace in minimal/bare).
# WORKSPACE_DIR=/workspace/workspace
WORKSPACE_HOST_PATH=./workspace

# Max agentic turns per agent run (safety bound).
AGENT_MAX_TURNS=40

# How many times a task may auto-request "continue?" after hitting the step
# limit before it's stalled instead. Stops a non-converging run (weak model
# grinding, repeating the same failing action) from looping "40 turns →
# continue → 40 turns" forever. Default 2 (i.e. up to 3 runs total).
MAX_CONTINUATIONS=2

# Hard ceiling for a single agent run (ms) of ACTIVE time: the clock stops while
# the agent waits for a person (an ask_user question, an approval). On expiry the
# run is aborted so it can't wedge a worker slot. Bump it for slow local models.
AGENT_RUN_TIMEOUT_MS=600000

# No-progress watchdog (ms): abort a run that has emitted no event for this long.
# Not applied while an approval is pending or a tool call is running. 0 = off.
AGENT_IDLE_TIMEOUT_MS=240000

# Soft token budgets, checked before each run (follow-ups included). Over budget
# -> the task becomes "blocked" with an explanation instead of running. 0 = unlimited.
# Per task, and per calendar day (server time) across all tasks.
# Since 0.1.60 the count includes EVERY billed token — input, output AND prompt-cache
# reads/writes (before, cache tokens were left out, so a limit was effectively
# 5-10x looser than its number). If you had limits set, multiply them by ~5
# to keep the same effective cap; Stats shows the cache share per provider.
BUDGET_TOKENS_PER_TASK=0
BUDGET_TOKENS_PER_DAY=0

# "Don't ask again" approval exceptions expire after this many days (0 = never).
APPROVAL_EXCEPTION_TTL_DAYS=30

# Strict completion contract. When true, a run that finishes cleanly but never
# called report_task_status is marked `stalled` (not silently `done`) — surfaces
# an agent that talked but did nothing. Leave off if you rely on weak local
# models that can't reliably emit the status tool.
REQUIRE_STATUS_REPORT=true

# ---- Agent isolation (S-01, docs/authentication.md) --------------------
# Run agents (the Claude CLI, Codex, their shells and MCP servers) as a separate
# unprivileged OS user while the orchestrator stays root: secrets/, the database
# and this file become unreadable to them. OFF by default in this dev stack
# (unset = agents run as the orchestrator's user). The minimal/bare-metal
# installer sets it on fresh installs; `aigentron harden` enables it later.
# Needs `setpriv` (util-linux) and the user to exist in the orchestrator's
# container/host (infra/harden.sh creates it); when set but broken, every
# agent run fails with the reason instead of running as root.
# AGENT_RUN_AS_UID=1500
# AGENT_RUN_AS_GID=1500
# The wrapper that drops privileges (default: <repo>/infra/agent-exec.sh).
# AGENT_EXEC_WRAPPER=/app/infra/agent-exec.sh

# ---- Approval gate ---------------------------------------------------
# URL the PreToolUse hook (running inside an agent) uses to reach the
# orchestrator approvals API. Inside docker this is the service name.
APPROVALS_API_URL=http://orchestrator:3001
# How long (seconds) the hook blocks waiting for a human verdict before
# defaulting to DENY (fail-closed).
APPROVAL_TIMEOUT_SECONDS=300

# ======================================================================
# MCP HOST — external-client entry point (Streamable HTTP at /api/mcp)
# ======================================================================
# Lets an external MCP client (Claude Desktop, Claude Code, a browser MCP
# client) create/track tasks on the fleet. Defaults on; set to false to disable.
MCP_HOST_ENABLED=true
# Optional DNS-rebinding guard: a comma-separated Origin allowlist. When set,
# requests whose Origin isn't listed are rejected. Leave empty to accept any
# origin (fine for a localhost-only setup).
# e.g. MCP_ALLOWED_ORIGINS=http://localhost:3000,https://claude.ai
MCP_ALLOWED_ORIGINS=
# Access token. Empty = open (localhost-only posture). STRONGLY recommended once
# the endpoint is exposed publicly (e.g. via an ngrok tunnel for claude.ai): set
# a long random value. Accepted as `Authorization: Bearer <token>` or a `?key=`
# query param (bake it into the connector URL for clients that can't set
# headers, like claude.ai). Generate: `openssl rand -hex 32`.
MCP_TOKEN=

# Skills as a read-on-demand index (name + description + file path) instead of
# inlining every declared skill's full text into the system prompt every turn.
# Big token saving on cheap models; the agent reads a skill file when it needs
# the full conventions. Set false to inline full skill text (old behavior).
SKILLS_LAZY=true

# Auto-deny an identical approval (same tool + signature) once it has already
# been gated this many times on one task — breaks a run that keeps requesting
# the same dangerous action without progress. 0 disables. Default 3.
APPROVAL_REPEAT_LIMIT=3

# Optional: host ports for postgres/redis (defaults 5432/6379)
# Interface the published ports bind to. 127.0.0.1 (default) = this machine only. 0.0.0.0 exposes the dashboard, API,
# LiteLLM, Postgres and Redis to your network — they have NO authentication; set LITELLM_MASTER_KEY + MCP_TOKEN and use a VPN/proxy.
# BIND_ADDRESS=127.0.0.1
# --- Sign-in (docs/authentication.md) ---
# Every user has their own password (login screen: pick your name, type the password). Normally the first one is set in the
# dashboard (banner / Settings → Security), the others in Settings → Users.
# For a headless install, ADMIN_PASSWORD is applied once for the default operator when no password exists yet (remove it afterwards).
# ADMIN_PASSWORD=
# Days a browser stays signed in (default 30).
# AUTH_SESSION_DAYS=30

# --- Remote access (docs/remote-access.md) ---
# The public address you reach the dashboard on (e.g. your Cloudflare Tunnel hostname). Added to the allowed origins AND the allowed
# domains (localhost / IPs / single-word names always work). Protect it with passwords (docs/authentication.md) and/or Cloudflare Access.
# PUBLIC_URL=https://dev.example.com
# Interface the orchestrator itself listens on. 127.0.0.1 = this machine only (e.g. behind a Cloudflare tunnel / reverse proxy on the same host); default 0.0.0.0.
# ORCHESTRATOR_HOST=127.0.0.1
# Cloudflare Tunnel connector token (Zero Trust -> Networks -> Tunnels). Used by the `tunnel` compose profile.
# TUNNEL_TOKEN=
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# --- Codex runtime (provider kind "codex": agents run on the OpenAI Codex CLI) ---
# Shared sign-in dir (holds auth.json). Default: <secrets dir>/codex — /workspace/secrets/codex (a named volume),
# deliberately OUTSIDE the agent dir. An older sign-in in agent/.codex-home is moved there automatically.
# Sign in once:  docker compose exec -it -e CODEX_HOME=/workspace/secrets/codex orchestrator codex login --device-auth
# CODEX_AUTH_HOME=
# Codex binary (default: "codex" on PATH; installed in the dev/minimal images).
# CODEX_BIN=

# --- Research tools (built-in MCP server "research": official-source search/fetch/verify_quote) ---
# fetch works out of the box for the allowed official domains (see agent/research.json to change them:
#   {"jurisdictions": {"eu": ["eur-lex.europa.eu"], "ua": ["zakon.rada.gov.ua"]}}).
# search needs ONE backend: a Brave Search API key, or a self-hosted SearXNG (JSON format enabled).
# BRAVE_API_KEY=
# RESEARCH_SEARXNG_URL=http://searxng:8080

# --- Browser through a proxy (optional; see docs/browser-proxy.md) -------------------------------------
# The second browser MCP server `playwright-proxy` sends all its traffic through this proxy. Then:
#   docker compose --profile proxy up -d playwright-mcp-proxy
# PLAYWRIGHT_PROXY_SERVER=proxy.example.com:3128
# PLAYWRIGHT_PROXY_USER=
# PLAYWRIGHT_PROXY_PASS=
# PLAYWRIGHT_PROXY_BYPASS=

# --- Browser add-on (optional; see docs/addons.md) ----------------------------------------------------
# A real Chromium on a virtual display in its own container: people watch/operate it through the dashboard (noVNC),
# agents drive it over CDP. `docker compose --profile browser up -d browser` (production installs: `aigentron addon enable browser`).
# Host ports are loopback-only (BIND_ADDRESS); the orchestrator reaches it as http://aigentron-browser:6080 / :9222.
# BROWSER_VIEW_HOST_PORT=6080
# BROWSER_CDP_HOST_PORT=9222
# off = start Chromium without the remote-debugging port (people only; agents cannot drive it)
# BROWSER_AGENT_CDP=on
# which browser the image is built with: empty = the distro's chromium (debian:12); chrome = Google Chrome stable (x86_64 only); playwright
# BROWSER_ADDON_BROWSER=

# ======================================================================
# ADVANCED / RARELY CHANGED — every variable the code reads that is not set above.
# All are optional; the defaults are shown. Uncomment to change.
# ======================================================================

# --- Paths -----------------------------------------------------------
# Task attachments (default <AGENT_DIR>/attachments).
# ATTACHMENTS_DIR=/workspace/agent/attachments
# Credentials and access settings kept out of the agent tree (default <AGENT_DIR>/../secrets).
# SECRETS_DIR=/workspace/secrets

# --- Agents and tasks --------------------------------------------------
# true (default in compose and all install profiles): every task works in the one project checkout, one at a time;
# false: a git worktree + branch + PR per task (docs/workspace-layout.md). The code default without this variable is false.
# WORKSPACE_SHARED=true
# Seeds "concurrency" in Settings on first boot only (default 2; forced to 1 in shared mode).
# AGENT_CONCURRENCY=2
# Max subtasks a lead may create per task (default 25).
# SUBTASK_LIMIT=25
# How long ask_user waits for a person to answer, seconds (default 3600, minimum 30).
# QUESTION_TIMEOUT_SECONDS=3600
# Longest side of an uploaded picture after shrinking, px (default 1600, minimum 640).
# IMAGE_MAX_SIDE=1600
# Set to true to switch the scheduler off (no schedules fire).
# SCHEDULER_DISABLED=false

# --- Addresses -------------------------------------------------------
# Base URL of the dashboard used in links the server sends (Telegram, MCP replies). Default http://localhost:3000.
# DASHBOARD_BASE_URL=http://localhost:3000
# Comma-separated exact origins allowed to call the API; * = any. Unset = localhost/127.0.0.1 (plus PUBLIC_URL).
# CORS_ORIGINS=
# Interface the optional web server (HTTPS on 443 / port 80) listens on (default 0.0.0.0; docs/remote-access.md).
# WEB_HOST=0.0.0.0
# Comma-separated peer IPs whose cf-connecting-ip header is believed for the sign-in rate limit
# (loopback and the compose cloudflared container are trusted automatically).
# TRUSTED_PROXY=

# --- Model gateway ---------------------------------------------------
# LiteLLM proxy address (default http://litellm:4000 in compose).
# LITELLM_BASE_URL=http://litellm:4000
# The REAL Ollama (for the model picker and LiteLLM routes) (the provider baseUrl may point at the LiteLLM gateway).
# OLLAMA_NATIVE_URL=http://host.docker.internal:11434
# Minimal/bare only: run LiteLLM as a child process of the orchestrator (docs/plan-single-container.md).
# LITELLM_MANAGED=1
# LITELLM_MANAGED_HOST=127.0.0.1
# LITELLM_MANAGED_COMMAND=litellm
# LITELLM_MANAGED_ARGS=
# LITELLM_MANAGED_CONFIG_PATH=/data/litellm-config.generated.yaml

# --- Updates (docs/updates.md) ----------------------------------------
# Set to 0/false/no to forbid updating from the dashboard.
# UPDATE_ENABLED=true
# GitHub repository releases are read from.
# UPDATE_REPO=Arttron/aigentron

# --- Housekeeping and disk (docs/workspace-layout.md §4, §4a) ---------
# Retention in days, 0 = never.
# RUNS_RETENTION_DAYS=14
# DIGEST_RETENTION_DAYS=30
# RESEARCH_CACHE_RETENTION_DAYS=180
# Old git worktrees are removed only on request unless CLEANUP_WORKTREES=true (worktree mode only).
# WORKTREE_RETENTION_DAYS=30
# CLEANUP_WORKTREES=false
# Free-space limits of the data disk: warning banner / automatic relief of regenerable caches.
# DISK_WARN_PERCENT=15
# DISK_WARN_GB=3
# DISK_CRITICAL_PERCENT=7
# DISK_CRITICAL_GB=1

# --- Live preview servers -----------------------------------------------
# PREVIEW_PUBLIC_HOST=orchestrator
# PREVIEW_PORT_BASE=3200
# PREVIEW_POOL_SIZE=4
# PREVIEW_READY_TIMEOUT_MS=120000
# PREVIEW_IDLE_MS=900000

# --- Internal wiring (normally left alone) ----------------------------
# Shared secret between the approval hook and the orchestrator (random per start if unset).
# LDS_HOOK_SECRET=
# HOOK_SCRIPT_PATH=
# SHARED_DIST_PATH=
# SHIPPED_AGENT_DIR=
# ATTACHMENTS_RETENTION_DAYS=0        # >0: delete attachments of FINISHED tasks after N days (0 = never, the default; your files)
# Dev stack: keep add-on state (docs/addons.md) in the bind-mounted workspace so it survives re-creates (must be set HERE, not in compose: .env replaces process.env)
# ADDONS_DIR=/workspace/workspace/addons
